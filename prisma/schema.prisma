// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Yoda {
  id      Int       @id @default(autoincrement())

  email   String    @unique

  first_name String
  last_name String
  patronymic String

  role Role? @default(YODA)

  password String
}

model Jedi {
  id      Int       @id @default(autoincrement())

  first_name String
  last_name String
  patronymic String

  password String
  
  email   String    @unique

  role Role? @default(JEDI)

  Padawan Padawan[]
}

model Padawan {
  id     Int     @id @default(autoincrement())
  
  first_name String
  last_name String
  patronymic String

  password String

  role Role? @default(PADAWAN)

  email  String  @unique
  feedback String[] @default([])

  jedi   Jedi?   @relation(fields: [jediId], references: [id]) 
  jediId Int?
}

enum Role {
  YODA
  JEDI
  PADAWAN
}