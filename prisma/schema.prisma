// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())

  first_name String
  last_name String
  patronymic String

  email    String  @unique
  password String
  role     Role

  padawans Padawan[] @relation("JediPadawans")
  Padawan  Padawan[]
}

model Padawan {
  id       Int    @id @default(autoincrement())
  userId   Int
  jediId   Int
  feedback String[] @default([])

  user     User   @relation(fields: [userId], references: [id])
  jedi     User   @relation("JediPadawans", fields: [jediId], references: [id])
}

enum Role {
  YODA
  JEDI
  PADAWAN
}
